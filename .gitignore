# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Cloudinary config
.env.local

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude: se ignora todo salvo los agentes (versionados, spec 010).
# Hay que ignorar el contenido (`.claude/*`) y no la carpeta: git no re-incluye
# un archivo si su carpeta padre está ignorada.
.claude/*
!.claude/agents/
.agents
.playwright-mcp

# Specs: son locales de cada quien y no se versionan, salvo la plantilla.
# Las 001-013 quedaron en el historial (git show e7226e6:specs/<carpeta>/spec.md).
specs/*
!specs/_template/

# Infisical local config
.infisical.json
# Reporte temporal de lint-ratchet
.lint-report.json
